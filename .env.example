# ---------------------------------------------------------------------------
# Perfume prompt preparer
#
# Copy to .env.local only if you want to change a default. Nothing here is
# required, and there are no API keys: the app scrapes public pages and derives
# prompts with deterministic rules.
# ---------------------------------------------------------------------------

# Where the JSON store and downloaded images live.
STUDIO_LOCAL_DATA_DIR=.data
STUDIO_LOCAL_STORAGE_DIR=.data/storage

# Human-browsable folder that saved prompt files are written into.
STUDIO_EXPORT_DIR=exports

# How many alternative takes on the concept to produce prompts for.
STUDIO_TAKE_COUNT=3

# Framing the prompt asks for: 1:1 | 4:5 | 9:16
STUDIO_DEFAULT_ASPECT_RATIO=4:5
